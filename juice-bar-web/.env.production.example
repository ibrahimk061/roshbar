# Copy to .env on the server and fill in the blanks. Never commit the real .env.
APP_NAME="Roshbar"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://roshbar.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning

# New database for the Laravel app (create it in cPanel > MySQL Databases).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Old site's database: read only, used once by `php artisan roshbar:import-legacy`.
LEGACY_DB_HOST=localhost
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=
LEGACY_UPLOADS_PATH=

POS_TIMEZONE=Asia/Dhaka
POS_ORDER_PREFIX=RB
POS_DAY_START_HOUR=0

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log

# First owner account (only used by `php artisan db:seed --class=OwnerSeeder`).
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# Only for the one-time /_setup page when the host has no Terminal.
# Make up 20+ random letters/numbers. Remove after setup is finished.
SETUP_TOKEN=
